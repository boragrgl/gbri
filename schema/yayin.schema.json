{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boragrgl/gbri/schema/yayin.schema.json",
  "title": "GBRI yayin kaydi",
  "type": "object",
  "required": ["id", "kurum", "baslik_orijinal", "baslik_tr", "url", "belge_turu", "statu", "onem",
               "onem_gerekcesi", "konu", "ozet_tek_satir", "yayin_tarihi", "tespit_zamani",
               "baslangic_arsivi", "ilgili_mi", "surumler"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"},
    "kurum": {"type": "string"},
    "baslik_orijinal": {"type": "string", "minLength": 1},
    "baslik_tr": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "belge_turu": {"enum": ["Kanun", "Yönetmelik", "Tebliğ", "Genelge", "Rehber", "Standart", "İstişare dokümanı",
                            "Rapor", "Basın duyurusu", "Bülten", "Konuşma"]},
    "statu": {"enum": ["Taslak", "İstişare", "Nihai", "Yürürlükte", "Bilgi amaçlı"]},
    "onem": {"enum": ["Kritik", "Yüksek", "Orta", "Düşük"]},
    "onem_gerekcesi": {"type": "string"},
    "konu": {"enum": ["TFRS 9", "Basel", "Sürdürülebilirlik", "Risk Yönetimi", "Diğer"]},
    "alt_konular": {"type": "array", "items": {"type": "string"}},
    "etkilenen_alanlar": {"type": "array", "items": {"type": "string"}},
    "ozet_tek_satir": {"type": "string"},
    "yayin_tarihi": {"type": "string", "format": "date"},
    "tespit_zamani": {"type": "string", "format": "date-time"},
    "gorus_son_tarihi": {"type": ["string", "null"], "format": "date"},
    "yururluk_tarihi": {"type": ["string", "null"], "format": "date"},
    "uyum_son_tarihi": {"type": ["string", "null"], "format": "date"},
    "baslangic_arsivi": {"type": "boolean"},
    "ilgili_mi": {"type": "boolean"},
    "analiz": {"$ref": "#/$defs/analiz"},
    "analiz_bilgisi": {
      "type": "object",
      "required": ["model", "olusturma_zamani", "alinti_dogrulanan", "alinti_toplam", "guven"],
      "properties": {
        "model": {"type": "string"},
        "olusturma_zamani": {"type": "string", "format": "date-time"},
        "gonderilen_karakter": {"type": "integer", "minimum": 0},
        "alinti_dogrulanan": {"type": "integer", "minimum": 0},
        "alinti_toplam": {"type": "integer", "minimum": 0},
        "guven": {"enum": ["Yüksek", "Orta", "Düşük"]}
      }
    },
    "surumler": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["no", "tespit_zamani", "icerik_hash"],
        "properties": {
          "no": {"type": "integer", "minimum": 1},
          "tespit_zamani": {"type": "string", "format": "date-time"},
          "icerik_hash": {"type": "string"},
          "degisiklik_notu": {"type": "string"}
        }
      }
    },
    "onceki_kayit": {"type": ["string", "null"]},
    "sonraki_kayit": {"type": ["string", "null"]},
    "ilgili_kayitlar": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "teyitli": {
      "type": "object", "required": ["hukum", "alinti", "alinti_dogrulandi"],
      "properties": {
        "hukum": {"type": "string"},
        "alinti": {"type": "string"},
        "sayfa": {"type": ["integer", "null"]},
        "paragraf": {"type": ["integer", "null"]},
        "alinti_dogrulandi": {"const": true}
      }
    },
    "bolum": {
      "type": "object",
      "properties": {
        "teyitli": {"type": "array", "items": {"$ref": "#/$defs/teyitli"}},
        "olasi_etki": {"type": "array", "items": {"type": "string"}},
        "ilgili_degil": {"type": "boolean"}
      }
    },
    "duzey": {"enum": ["Yüksek", "Orta", "Düşük", "Dolaylı", "Etki beklenmiyor", "İlgili değil"]},
    "analiz": {
      "type": "object",
      "required": ["yonetici_ozeti"],
      "properties": {
        "yonetici_ozeti": {"type": "string"},
        "amac": {"$ref": "#/$defs/bolum"},
        "onceki_cerceve": {
          "allOf": [{"$ref": "#/$defs/bolum"}],
          "properties": {"karsilastirma_kaynagi": {"enum": ["arsiv", "genel_bilgi"]}}
        },
        "degisiklikler": {
          "type": "array",
          "items": {"type": "object", "required": ["konu", "yeni"],
                    "properties": {"konu": {"type": "string"}, "onceki": {"type": "string"},
                                   "yeni": {"type": "string"}, "referans": {"type": "string"}}}
        },
        "teknik_etkiler": {"$ref": "#/$defs/bolum"},
        "operasyonel_etki": {"$ref": "#/$defs/bolum"},
        "parametre_etkisi": {
          "type": "object",
          "properties": {
            "PD": {"$ref": "#/$defs/parametre"}, "LGD": {"$ref": "#/$defs/parametre"},
            "EAD": {"$ref": "#/$defs/parametre"}, "ECL": {"$ref": "#/$defs/parametre"}
          }
        },
        "sermaye_rwa": {"$ref": "#/$defs/bolum"},
        "iklim": {"$ref": "#/$defs/bolum"},
        "tarihler": {
          "type": "array",
          "items": {"type": "object", "required": ["tur", "tarih"],
                    "properties": {"tur": {"type": "string"}, "tarih": {"type": ["string", "null"]},
                                   "referans": {"type": "string"}}}
        },
        "gozden_gecirilecekler": {
          "type": "array",
          "items": {"type": "object", "required": ["baslik"],
                    "properties": {"baslik": {"type": "string"}, "aciklama": {"type": "string"}}}
        },
        "referanslar": {
          "type": "array",
          "items": {"type": "object", "required": ["metin"],
                    "properties": {"metin": {"type": "string"}, "sayfa": {"type": ["integer", "null"]},
                                   "paragraf": {"type": ["integer", "null"]}}}
        }
      }
    },
    "parametre": {
      "type": "object", "required": ["duzey"],
      "properties": {"duzey": {"$ref": "#/$defs/duzey"}, "not": {"type": "string"}}
    }
  }
}
